{
  "name": "teacher-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Dependency-free static teacher portfolio; development tools only",
  "scripts": {
    "test": "node tests/run-suite.cjs",
    "test:content": "node --test tests/*.test.cjs",
    "test:browser": "playwright test",
    "screenshots": "node tests/capture.cjs",
    "format": "prettier --write *.html *.css *.js tests/*.cjs resources/*.html resources/*.css"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "axe-core": "^4.14.0",
    "prettier": "^3.9.10"
  }
}
